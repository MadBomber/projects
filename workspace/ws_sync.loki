# frozen_string_literal: true
# Sync shared files and bump versions across repos, and switch the bundle
# mode (dev/prod) for the whole workspace.

class Tasks

  # Bundle-mode switching requires the project root .envrc to follow the
  # .bundle_mode pattern (see robot_lab_project/.envrc): the tasks write
  # .bundle_mode, the .envrc reads it via watch_file to export BUNDLE_GEMFILE,
  # and every component inherits it through source_up — component .envrc files
  # must NOT re-export BUNDLE_GEMFILE. A project still on the legacy single
  # `export BUNDLE_GEMFILE=...` .envrc line must migrate before these tasks
  # have any effect there (robot_lab_project and sqa_project both follow the
  # new pattern).

  desc "dev", "Switch every component to Gemfile.local (local path: deps)"
  def dev
    set_bundle_mode("dev", "Gemfile.local")
  end

  desc "prod", "Switch every component to Gemfile (released gems)"
  def prod
    set_bundle_mode("prod", "Gemfile")
  end

  desc "local", "Alias for dev (Gemfile.local)"
  def local = dev

  desc "real", "Alias for prod (Gemfile)"
  def real = prod

  desc "set_env [ENV]", "Switch bundle mode. ENV: dev|prod (local|real also accepted; omit to toggle)"
  def set_env(env = nil)
    case env
    when "dev", "local" then dev
    when "prod", "real" then prod
    when nil            then current_bundle_mode == "dev" ? prod : dev
    else abort "Unknown env '#{env}' — use 'dev' or 'prod'"
    end
  end

  desc "Sync Rakefile, .rubocop.yml, and version to all repos in parallel"
  depends_on [:sync_rakefiles, :sync_rubocop, :sync_versions]
  def sync; end

  desc "Set all extension version.rb files to match the core gem's version"
  def sync_versions
    core = read_version_file(@@core)
    abort "Could not read core version" if core.start_with?("(")

    puts "\nSyncing extensions to core version \e[1;36m#{core}\e[0m\n\n"
    @@extensions.each do |repo|
      old = read_version_file(repo)
      if old == core
        printf "  \e[33m==\e[0m  %-32s already at %s\n", repo, core
      else
        write_version_file(repo, core)
        printf "  \e[32m->\e[0m  %-32s %s -> %s\n", repo, old, core
      end
    end
    puts "\nDone. Run `asgard versions` to verify."
  end

  desc "Propagate Rakefile.common to all extension repos"
  def sync_rakefiles
    abort "Rakefile.common not found" unless File.exist?("Rakefile.common")
    @@extensions.each do |repo|
      sh "cp Rakefile.common \"#{repo}/Rakefile\""
      printf "\e[1;32m%-32s\e[0m updated\n", repo
    end
  end

  desc "Propagate .rubocop.yml to all gem-family repos (copy-based projects only)"
  def sync_rubocop
    source = ".rubocop.yml.common"
    unless File.exist?(source)
      puts "No #{source} — this project uses inherited RuboCop config (.rubocop-base.yml); nothing to sync."
      return
    end
    @@family.each do |repo|
      sh "cp \"#{source}\" \"#{repo}/.rubocop.yml\""
      printf "\e[1;32m%-32s\e[0m updated\n", repo
    end
  end

  desc "bump_versions [VERSION]", "Bump all version.rb files. Omit VERSION to sync extensions to core."
  option :yes, aliases: "-y", type: :boolean, default: false, desc: "Skip confirmation prompt"
  def bump_versions(target_version = nil)
    target = target_version.to_s

    if target.empty?
      target = read_version_file(@@core)
      repos_to_update = @@extensions
      action = "Sync extensions to core version #{target}"
    else
      abort "Invalid version '#{target}' — expected N.N.N or N.N.N.N" unless target.match?(/\A\d+\.\d+\.\d+(\.\d+)?\z/)
      repos_to_update = @@family
      action = "Bump all #{@@core} gems to #{target}"
    end

    unless options[:yes]
      print "#{action} — continue? [y/N] "
      $stdout.flush
      return puts "Aborted." unless $stdin.gets.strip.downcase == "y"
    end

    puts "#{action}...\n\n"
    repos_to_update.each do |repo|
      old   = read_version_file(repo)
      write_version_file(repo, target)
      arrow = old == target ? "\e[33m==\e[0m" : "\e[32m->\e[0m"
      printf "  %-32s %s %s %s\n", repo, old, arrow, target
    end

    puts "\nDone. Run `asgard versions` to verify."
  end

  no_commands do
    def current_bundle_mode
      File.exist?(".bundle_mode") ? File.read(".bundle_mode").strip : "dev"
    end

    # Writes .bundle_mode, which the project root .envrc reads (via watch_file)
    # to set BUNDLE_GEMFILE for every component through source_up inheritance.
    # Warns about any component .envrc that still overrides BUNDLE_GEMFILE,
    # since an override would silently beat the project-wide setting.
    def set_bundle_mode(mode, gemfile)
      File.write(".bundle_mode", "#{mode}\n")
      puts "Bundle mode: #{mode} — BUNDLE_GEMFILE=#{gemfile} for all components"
      puts "direnv reloads at the next shell prompt; new shells inherit automatically."
      offenders = @@repos.select do |repo|
        envrc = File.join(repo, ".envrc")
        File.file?(envrc) && File.read(envrc).match?(/^\s*export BUNDLE_GEMFILE=/)
      end
      return if offenders.empty?

      puts <<~WARNING
        \e[33mWarning:\e[0m these components still export BUNDLE_GEMFILE in their own
        .envrc, which overrides the project-wide setting — remove the export line:
          #{offenders.join("\n  ")}
      WARNING
    end

    def read_version_file(repo)
      file = Dir.glob("#{repo}/lib/**/version.rb").first
      return "(not found)" unless file
      File.read(file)[/VERSION\s*=\s*['"]([^'"]+)['"]/, 1] || "(parse error)"
    end

    def write_version_file(repo, new_version)
      file = Dir.glob("#{repo}/lib/**/version.rb").first
      return unless file
      content = File.read(file)
      updated = content.sub(/VERSION\s*=\s*(['"])([^'"]+)\1/, "VERSION = \\1#{new_version}\\1")
      File.write(file, updated)
    end
  end
end
